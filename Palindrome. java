class Result {
    public static int palindromeIndex(String s) {
        int left = 0;
        int right = s.length() - 1;
        
        while (left < right) {
            if (s.charAt(left) != s.charAt(right)) {
                // If mismatch, check if removing the left character fixes it
                if (isPalindrome(s, left + 1, right)) {
                    return left;
                }
                // Check if removing the right character fixes it
                if (isPalindrome(s, left, right - 1)) {
                    return right;
                }
                return -1; // If neither works, no single deletion can fix it
            }
            left++;
            right--;
        }
        return -1; // Already a palindrome
    }
    
    private static boolean isPalindrome(String s, int left, int right) {
        while (left < right) {
            if (s.charAt(left) != s.charAt(right)) {
                return false;
            }
            left++;
            right--;
        }
        return true;
    }
}
